<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Cluewren</RootNamespace>
    <AssemblyName>cluewren</AssemblyName>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <TieredPGO>true</TieredPGO>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Sandbox\Child\**" />
    <None Remove="Sandbox\Child\**" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Mcp\Instructions.md" LogicalName="Instructions.md" />
    <EmbeddedResource Include="Mcp\Skill.md" LogicalName="Skill.md" />
    <EmbeddedResource Include="..\..\docs\KIT.md" LogicalName="KIT.md" />
    <EmbeddedResource Include="..\..\docs\KIT-UNITY.md" LogicalName="KIT-UNITY.md" />
    <EmbeddedResource Include="..\..\docs\KIT-GODOT.md" LogicalName="KIT-GODOT.md" />
    <EmbeddedResource Include="..\..\docs\KIT-UNREAL.md" LogicalName="KIT-UNREAL.md" />
    <EmbeddedResource Include="..\..\docs\KIT-PLAN.md" LogicalName="KIT-PLAN.md" />
    <EmbeddedResource Include="..\..\docs\KIT-FIGHT.md" LogicalName="KIT-FIGHT.md" />
    <EmbeddedResource Include="..\..\docs\KIT-POINTER.md" LogicalName="KIT-POINTER.md" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Cluewren.Kit\Cluewren.Kit.csproj" />
    <ProjectReference Include="Sandbox\Child\Cluewren.Child.csproj" />
  </ItemGroup>

</Project>
