{
    "name": "Cluewren.Tests",
    "rootNamespace": "Cluewren.Tests",
    "references": [
        "Cluewren",
        "Cluewren.Editor",
        "UnityEngine.TestRunner",
        "UnityEditor.TestRunner",
        "Unity.InputSystem",
        "Unity.InputSystem.TestFramework"
    ],
    "includePlatforms": [
        "Editor"
    ],
    "excludePlatforms": [],
    "allowUnsafeCode": false,
    "overrideReferences": true,
    "precompiledReferences": [
        "nunit.framework.dll"
    ],
    "autoReferenced": false,
    "defineConstraints": [
        "UNITY_INCLUDE_TESTS"
    ],
    "versionDefines": [
        {
            "name": "com.unity.inputsystem",
            "expression": "1.0.0",
            "define": "CLUEWREN_INPUT_SYSTEM"
        },
        {
            "name": "com.unity.modules.screencapture",
            "expression": "1.0.0",
            "define": "CLUEWREN_SCREENCAPTURE"
        },
        {
            "name": "com.unity.modules.imageconversion",
            "expression": "1.0.0",
            "define": "CLUEWREN_IMAGECONVERSION"
        }
    ],
    "noEngineReferences": false
}
